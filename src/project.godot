; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[addons]

resources_spreadsheet_view/array_color_tint=100.0
resources_spreadsheet_view/color_rows=true
resources_spreadsheet_view/array_min_width=128.0
resources_spreadsheet_view/resource_preview_size=32.0
resources_spreadsheet_view/clip_headers=false
resources_spreadsheet_view/dupe_arrays=true
resources_spreadsheet_view/context_menu_on_leftclick=false
resources_spreadsheet_view/fold_docks=true
resources_spreadsheet_view/resource_cell_label_mode=1
resources_spreadsheet_view/freeze_first_column=true

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="从零开始的异世界塔防"
run/main_scene="uid://nvbnnvwovpao"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://autoloads/managers/audio_manager/audio_bus_layout.tres"

[autoload]

EntityUtils="*uid://bvr5hlc6so6aa"
DebugManager="*uid://dswgweyvy78e4"
GlobalManager="*uid://ct01c5jk3ruit"
TranslationManager="*uid://duh6g6j1nnv23"
InputManager="*uid://co6qf5rf1ox2n"
SettingManager="*uid://dwcme4eew22uo"
CanvasManager="*uid://bsabxvw5o5g4l"
AudioManager="*uid://vs7lopahte38"
ChangeSceneManager="*uid://bygipxugxq6jf"
GameManager="*res://autoloads/managers/game_manager.gd"
WaveManager="*uid://ssg02uvoaqp7"
SelectManager="*uid://ceidpau7qbnp1"
DamageManager="*uid://oorn7hxbr0ya"
TimeManager="*res://autoloads/managers/time_manager.gd"
GridManager="*uid://bsty3nv6hyvtv"
PathwayManager="*res://autoloads/managers/pathway_manager.gd"
NodeConfigManager="*uid://cjutve3qggyot"
ECSSettingManager="*uid://0xyrcdosy5ag"
ECSEntityManager="*uid://2v61hpwjm2g1"
ECSSystemManager="*uid://bmu2424omrcbk"

[display]

window/size/viewport_width=2560
window/size/viewport_height=1440
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/bbcode_edit.editor/plugin.cfg", "res://addons/godot_ecs/plugin.cfg", "res://addons/log/plugin.cfg", "res://addons/mask_check/plugin.cfg", "res://addons/utils/plugin.cfg")

[file_customization]

folder_colors={
"res://autoloads/": "gray",
"res://classes/": "gray",
"res://classes/components/": "green",
"res://classes/systems/": "green",
"res://controls/": "gray",
"res://docs/": "purple",
"res://entities/": "green",
"res://entities/enemies/": "red",
"res://entities/towers/": "teal",
"res://game/": "green",
